{
  "manifest_version": 3,
  "name": "H-Structuur Checker",
  "version": "1.0.0",
  "description": "Analyseer de heading-hiërarchie van elke webpagina op fouten en structuurproblemen.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "48": "icons/icon.svg",
      "128": "icons/icon.svg"
    }
  },
  "icons": {
    "16": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  }
}
